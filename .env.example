# -------------------------------------------------------
# Action Guardrail — Environment Variables
# Copy this file to .env and fill in your values
# -------------------------------------------------------

# Groq API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# Database URL
# SQLite (local/dev):  sqlite:///./action_guardrail.db
# PostgreSQL (prod):   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./action_guardrail.db
